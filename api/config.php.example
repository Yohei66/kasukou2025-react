<?php
/**
 * 設定ファイルの記入例。
 *
 * このファイル自体は読み込まれません。パスワードを含まないので Git に入れてあります。
 *
 * 【使い方】
 *  1. このファイルをコピーして「config.php」という名前で保存する
 *  2. 下の値を、契約したサーバーの実際の値に書き換える
 *  3. サーバーにアップロードする（api.zip には入れない。下の【注意】参照）
 *
 *  記入済みのファイルは、このリポジトリでは deploy/config.php に置く運用です。
 *  deploy/ は .gitignore 済みで、api.zip にも入りません。
 *
 * 【置き場所】
 *  公開ディレクトリ（public_html）の外に置くのが安全。
 *    public_html/api/    ← プログラム
 *    config.php          ← ここ（public_html と同じ階層）
 *
 *  サーバーの都合で外に置けない場合は public_html/api/config.php でも動く。
 *
 * 【注意】
 *  ・このファイルの中身はパスワードそのもの。Git には入れないこと（.gitignore 済み）
 *  ・api/ に置いたままだと api.zip に混入し、ローカル開発でも読み込まれて
 *    開発用DBに接続できなくなる（設定ファイルは環境変数より優先されるため）
 *
 * 【ローカル開発では不要】
 *  Docker Compose で動かす場合、この設定ファイルは要りません。
 *  値は .env → docker-compose.yml → 環境変数 の経路で渡されます。
 */

return [
    // ---- データベース ----
    // レンタルサーバーの管理画面「データベース設定」で作成した値を入れる。
    // DB_HOST はサーバーによって異なる（localhost のこともあれば専用のホスト名のこともある）。
    'DB_HOST'     => 'localhost',
    'DB_NAME'     => 'データベース名',
    'DB_USER'     => 'データベースのユーザー名',
    'DB_PASSWORD' => 'データベースのパスワード',

    // ---- 管理者ログイン（管理者は1人） ----
    // 試験用サーバーと本番サーバーで別のパスワードにすること。
    'ADMIN_USER'     => '管理者のログインID',
    'ADMIN_PASSWORD' => '管理者のパスワード',

    // ---- コート中止連絡の合言葉（会員が中止登録するときに入力する） ----
    'CANCEL_PASSWORD' => '会員に伝える合言葉',

    // ---- 問い合わせフォームの通知メール ----
    // 両方そろって初めてメールが送られる。空ならDBに保存されるだけ。
    // CONTACT_FROM はサーバーのドメインのアドレスにする（SPFで弾かれないため）。
    // 試験用サーバーでは CONTACT_TO を自分のアドレスにしておくこと。
    'CONTACT_TO'   => 'tantou@example.com',
    'CONTACT_FROM' => 'noreply@あなたのサーバーのドメイン',

];
