# このファイルは記入例です。
# コピーして「.env」という名前で保存し、値を実際のものに書き換えてください。
#   （Windowsのエクスプローラーで名前を .env にできない場合は、
#     VSCode で新規ファイル「.env」を作って中身を貼り付けてください）
# .env は Git に入りません（.gitignore 済み）。

# 管理者ログイン（管理者は1人）
ADMIN_USER=admin
ADMIN_PASSWORD=ここに好きなパスワード

# コート中止連絡の合言葉（会員が中止登録するときに入力するもの）
CANCEL_PASSWORD=ここに好きな合言葉

# 問い合わせフォームの通知メール（両方そろうとメールが送られます）
# CONTACT_TO   = 受信したいメールアドレス
# CONTACT_FROM = 送信元アドレス（できればサーバーのドメインのもの）
CONTACT_TO=
CONTACT_FROM=
