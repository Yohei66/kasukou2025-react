# ローカル開発（Docker Compose）用の設定の記入例。
#
# 【使い方】
#   このファイルを ".env" という名前でコピーし、必要な値を書き換えてください。
#   （Windowsのエクスプローラーで名前を .env にできない場合は、
#     VSCode で新規ファイル「.env」を作って中身を貼り付けてください）
#   .env が無くても docker-compose.yml 側の既定値で起動はできます。
#
# 【反映方法】
#   値を書き換えたら「docker compose down」→「docker compose up -d」で反映されます。
#
# 【注意】
#   .env はパスワードを含むため Git に入りません（.gitignore 済み）。
#   このファイル（.env.example）は値を伏せてあるので Git に入れて構いません。
#
# 【サーバー（試験・本番）の設定はこちらではありません】
#   レンタルサーバーには環境変数を設定する手段が無いことが多いため、
#   サーバー側は api/config.php.example をコピーした設定ファイルを使います。
#   詳しくは README.md「設定（環境依存の値）」を参照してください。

# ---- 管理者ログイン（管理者は1人） ----
ADMIN_USER=admin
ADMIN_PASSWORD=変更してください

# ---- コート中止連絡の合言葉 ----
CANCEL_PASSWORD=変更してください

# ---- 問い合わせフォームの通知メール ----
# 両方そろって初めてメールが送られます。空ならDBに保存されるだけです。
CONTACT_TO=
CONTACT_FROM=

# ---- 開発用データベース（docker-compose が db / php 両コンテナに渡します） ----
# ここを変えたあとは「docker compose down -v」でボリュームごと作り直してください。
# （MariaDB はデータが残っていると、ユーザー名やパスワードの変更を反映しません）
DB_HOST=db
DB_NAME=devdb
DB_USER=devuser
DB_PASSWORD=devpass
DB_ROOT_PASSWORD=rootpass
